@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar" aria-label="Main navigation">
        <a href="/" class="brand" aria-label="StudyFlow dashboard">
            <span class="brand-icon" aria-hidden="true">✳</span>
            <span>Study<span class="brand-highlight">Flow</span><small>YOUR STUDY SPACE</small></span>
        </a>
        <div class="sidebar-heading">WORKSPACE</div>
        <nav class="sidebar-nav" aria-label="Primary">
            <NavLink href="/" Match="NavLinkMatch.All"><span aria-hidden="true">◫</span> Dashboard</NavLink>
            <NavLink href="/tasks"><span aria-hidden="true">☑</span> My tasks</NavLink>
            <NavLink href="/calendar"><span aria-hidden="true">▦</span> Calendar</NavLink>
            <NavLink href="/courses"><span aria-hidden="true">▤</span> Courses</NavLink>
            <NavLink href="/focus"><span aria-hidden="true">◎</span> Focus mode</NavLink>
        </nav>
        <div class="sidebar-bottom">
            <div class="tip-icon" aria-hidden="true">✦</div>
            <strong>Little steps, big goals.</strong>
            <p>One completed task gets you closer.</p>
            <NavLink href="/about" class="sidebar-about">About StudyFlow</NavLink>
        </div>
    </aside>
    <main class="main-area" id="main-content">
        <div class="topbar">
            <div class="breadcrumb">STUDENT WORKSPACE <span>/</span> <strong>STUDYFLOW</strong></div>
            <div class="topbar-right"><span class="online-dot"></span> Local workspace <span class="avatar" aria-label="Single-user workspace">S</span></div>
        </div>
        <div class="page-wrap">@Body</div>
        <footer class="footer">StudyFlow · C# / .NET 10 / Blazor <span>Built for focused learning</span></footer>
    </main>
</div>
<nav class="mobile-nav" aria-label="Mobile navigation">
    <NavLink href="/" Match="NavLinkMatch.All">◫<span>Home</span></NavLink>
    <NavLink href="/tasks">☑<span>Tasks</span></NavLink>
    <NavLink href="/calendar">▦<span>Calendar</span></NavLink>
    <NavLink href="/courses">▤<span>Courses</span></NavLink>
    <NavLink href="/focus">◎<span>Focus</span></NavLink>
</nav>
